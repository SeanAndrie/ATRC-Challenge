# OpenRouter chatbot credentials for the /chatbot page.
#
# Copy this file to `.env` (gitignored) and fill in your values, or set the
# same names as environment variables or Streamlit secrets. The sidebar on the
# /chatbot page can also set and save them.
#
# Resolution order (first non-empty wins):
#   sidebar > st.secrets > environment variables > this file

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Any tool-capable model on https://openrouter.ai/models — change freely.
OPENROUTER_MODEL=openai/gpt-4o-mini
