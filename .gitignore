# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# OpenSky API Credentials
credentials.json

# marimo session cache. Regenerable; per-notebook run state, not source.
notebooks/__marimo__/

# Data tiers.
#
# data/interim/ and data/processed/ ARE tracked, ~4 MB combined, so a clean
# clone can reproduce every published number without re-downloading anything.

# Generated diagnostics reports also land in outputs/ (see paths.REPORT_*), so
# the single /outputs/* rule below covers them:
#   .venv/bin/python pipeline/tests/test_market_link.py
#   .venv/bin/python pipeline/tests/test_aggregate_link.py
#   .venv/bin/python pipeline/tests/test_retarget_international.py
#   .venv/bin/python pipeline/tests/test_p2p_vs_pax.py

# Submission artifacts are built for release, not committed:
#   charts, the 10-page PDF, the 1-2 minute video.
/outputs/*
!/outputs/.gitkeep
